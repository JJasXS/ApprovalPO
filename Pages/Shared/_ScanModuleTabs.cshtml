@model string
@{
    var active = (Model ?? "scan").Trim().ToLowerInvariant();
    var scanOn = active == "scan";
    var receivedOn = active == "received";
}
<nav class="scan-module-tabs" role="tablist" aria-label="Scan purchase order or goods received">
    <a asp-page="/ScanPO"
       class="scan-module-tab@(scanOn ? " is-active" : "")"
       role="tab"
       aria-selected="@(scanOn ? "true" : "false")">Scan Purc. Order</a>
    <a asp-page="/ReceivedGoods"
       class="scan-module-tab@(receivedOn ? " is-active" : "")"
       role="tab"
       aria-selected="@(receivedOn ? "true" : "false")">Goods Received</a>
</nav>
