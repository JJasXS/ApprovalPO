@page
@model ApprovalPO.Pages.DatabasesModel
@{
    ViewData["Title"] = "Connect databases";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/databases.css" asp-append-version="true" />
}

<div class="dash-shell">
    <header class="dash-header">
        <div class="dash-header-inner">
            <div class="dash-brand">
                <a href="/Dashboard" class="dash-brand-home" title="Overview">
                    <svg class="dash-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </a>
                <span class="dash-brand-name">ProAcc Approvals</span>
            </div>
            <div class="dash-header-actions">
                <button id="menuBtn" class="dash-menu-btn" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="menuPanel" class="dash-menu-panel app-menu-panel" aria-hidden="true">
                    <div class="dash-menu-user app-menu-user">
                        <span class="app-menu-avatar" aria-hidden="true">@((userName?.Trim().Length > 0 ? char.ToUpperInvariant(userName.Trim()[0]) : 'U'))</span>
                        <div class="app-menu-user-copy">
                            <span class="app-menu-kicker">Signed in</span>
                            <span class="app-menu-name">@userName</span>
                        </div>
                    </div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "dash-menu-link" })
                    <form method="post" asp-page="/Logout" class="dash-menu-signout app-menu-signout">
                        <button type="submit" class="dash-menu-link dash-menu-link--danger app-nav-link app-nav-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dash-main">
        <div class="db-page">
            <p class="db-kicker">Settings</p>
            <h1 class="db-title">Connect databases</h1>
            <p class="db-lead">
                Register each SQL Accounting company <code>.FDB</code> this app can open.
                Purchase, Sales, Goods Received, and Delivery Orders use the same menus — switch company with the tabs on those pages.
            </p>

            <section class="db-card" aria-labelledby="dbSecretTitle">
                <h2 id="dbSecretTitle" class="db-card-title">Secrets Manager</h2>
                <dl class="db-meta">
                    <div>
                        <dt>Tenant</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.TenantCode) ? "—" : Model.TenantCode)</dd>
                    </div>
                    <div>
                        <dt>Secret</dt>
                        <dd class="db-path">@(string.IsNullOrWhiteSpace(Model.SecretId) ? "—" : Model.SecretId)</dd>
                    </div>
                    <div>
                        <dt>Stored databases</dt>
                        <dd>@Model.CompanyCount</dd>
                    </div>
                </dl>
                @if (Model.Companies.Any(c => c.UseTenantBootstrap))
                {
                    <form method="post" asp-page-handler="PersistBootstrap" class="db-inline-form">
                        <button type="submit" class="db-btn db-btn--secondary">Persist current connection to Secrets Manager</button>
                    </form>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <p class="db-flash db-flash--ok" role="status">@Model.StatusMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <p class="db-flash db-flash--err" role="alert">@Model.ErrorMessage</p>
            }

            <section class="db-card" aria-labelledby="dbListTitle">
                <h2 id="dbListTitle" class="db-card-title">Companies</h2>
                @if (Model.Companies.Count == 0)
                {
                    <p class="db-empty">No companies yet. Add one below.</p>
                }
                else
                {
                    <ul class="db-list">
                        @foreach (var c in Model.Companies)
                        {
                            var isActive = string.Equals(c.Id, Model.ActiveCompanyId, StringComparison.OrdinalIgnoreCase);
                            <li class="db-list-item @(isActive ? "is-active" : "")">
                                <div class="db-list-main">
                                    <span class="db-list-name">@c.DisplayName</span>
                                    @if (isActive)
                                    {
                                        <span class="db-pill">Active</span>
                                    }
                                    @if (c.UseTenantBootstrap)
                                    {
                                        <span class="db-pill db-pill--muted">Bootstrap</span>
                                    }
                                    <span class="db-list-path">@(string.IsNullOrWhiteSpace(c.FbPath) ? "tenant-config" : c.FbPath)</span>
                                </div>
                                <div class="db-list-actions">
                                    <a class="db-link" href="/SelectCompany?id=@Uri.EscapeDataString(c.Id)&amp;returnUrl=@Uri.EscapeDataString("/Databases")">Use</a>
                                    <a class="db-link" asp-page="/Databases" asp-route-edit="@c.Id">Edit</a>
                                    <form method="post" asp-page-handler="Delete" class="db-inline-form" onsubmit="return confirm('Remove this company from Secrets Manager?');">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="db-link db-link--danger">Delete</button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="db-card" aria-labelledby="dbFormTitle">
                <h2 id="dbFormTitle" class="db-card-title">@(string.IsNullOrWhiteSpace(Model.Input.Id) ? "Add company" : "Edit company")</h2>
                <p class="db-form-hint">Connects on <strong>localhost:3050</strong> (Firebird on this server).</p>
                <form method="post" class="db-form" novalidate>
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="db-field">
                        <label asp-for="Input.DisplayName"></label>
                        <input asp-for="Input.DisplayName" class="db-input" autocomplete="organization" />
                        <span asp-validation-for="Input.DisplayName" class="db-field-error"></span>
                    </div>
                    <div class="db-field">
                        <label asp-for="Input.FbPath"></label>
                        <input asp-for="Input.FbPath" class="db-input" placeholder="D:\ACC\COMPANY.FDB" autocomplete="off" />
                        <button type="button" class="db-browse-trigger" id="dbBrowseOpen">
                            <svg class="db-browse-clip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21.44 11.05l-8.49 8.49a5.5 5.5 0 0 1-7.78-7.78l8.49-8.49a3.5 3.5 0 0 1 4.95 4.95l-8.49 8.49a1.5 1.5 0 1 1-2.12-2.12l7.78-7.78"/>
                            </svg>
                            <span>Browse...</span>
                        </button>
                        <span asp-validation-for="Input.FbPath" class="db-field-error"></span>
                    </div>
                    <div class="db-field-row db-field-row--login">
                        <div class="db-field">
                            <label asp-for="Input.FbUser"></label>
                            <input asp-for="Input.FbUser" class="db-input" autocomplete="username" />
                            <span asp-validation-for="Input.FbUser" class="db-field-error"></span>
                        </div>
                        <div class="db-field">
                            <label asp-for="Input.FbPassword"></label>
                            <input asp-for="Input.FbPassword" class="db-input" type="password" autocomplete="new-password" placeholder="@(string.IsNullOrWhiteSpace(Model.Input.Id) ? "" : "Leave blank to keep")"/>
                            <span asp-validation-for="Input.FbPassword" class="db-field-error"></span>
                        </div>
                    </div>
                    <div class="db-actions">
                        <button type="submit" formaction="?handler=Save" class="db-btn db-btn--primary">Save to Secrets Manager</button>
                        <button type="submit" formaction="?handler=Test" class="db-btn db-btn--secondary" formnovalidate>Test connection</button>
                        @if (!string.IsNullOrWhiteSpace(Model.Input.Id))
                        {
                            <a class="db-btn db-btn--ghost" href="/Databases">Cancel</a>
                        }
                    </div>
                </form>
            </section>
        </div>
    </main>
</div>

<div id="dbBrowseModal" class="db-browse-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="dbBrowseTitle">
    <div class="db-browse-panel db-browse-panel--open">
        <div class="db-browse-titlebar">
            <h2 id="dbBrowseTitle" class="db-browse-title">Open</h2>
            <button type="button" class="db-browse-close" id="dbBrowseClose" aria-label="Close">×</button>
        </div>
        <div class="db-browse-nav">
            <button type="button" class="db-browse-nav-btn" id="dbBrowseUp" title="Up one level" aria-label="Up one level">↑</button>
            <div class="db-browse-address" id="dbBrowsePath">This PC</div>
        </div>
        <p class="db-browse-error" id="dbBrowseError" hidden></p>
        <div class="db-browse-table-wrap">
            <table class="db-browse-table" aria-label="Files and folders">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Date modified</th>
                        <th scope="col">Type</th>
                        <th scope="col">Size</th>
                    </tr>
                </thead>
                <tbody id="dbBrowseList"></tbody>
            </table>
        </div>
        <div class="db-browse-footer">
            <div class="db-browse-footer-row">
                <label class="db-browse-footer-label" for="dbBrowseFileName">File name:</label>
                <input type="text" id="dbBrowseFileName" class="db-browse-filename" readonly />
            </div>
            <div class="db-browse-footer-row">
                <label class="db-browse-footer-label" for="dbBrowseFilter">File type:</label>
                <select id="dbBrowseFilter" class="db-browse-filter" disabled>
                    <option>Firebird Database (*.fdb;*.gdb)</option>
                </select>
                <div class="db-browse-footer-actions">
                    <button type="button" class="db-browse-open-btn" id="dbBrowseConfirm" disabled>Open</button>
                    <button type="button" class="db-browse-cancel-btn" id="dbBrowseCancel">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/databases.js" asp-append-version="true"></script>
}
