@page "/ScanSO"
@model ApprovalPO.Pages.ScanSOModel
@{
    ViewData["Title"] = "Delivery Orders";
    ViewData["AppName"] = "Approval PO";
    var ordersJsonUrl = Url.Page("/ScanSO", null, new { handler = "OrdersJson" })!;
    var detailPageUrl = "/ScanSODetail";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />

<div id="scanSoPageConfig" hidden
     data-orders-json-url="@ordersJsonUrl"
     data-detail-page-url="@detailPageUrl"></div>

<header class="scan-header">
    <div class="scan-header-inner">
        <div class="scan-header-titles">
            <a asp-page="/Dashboard" class="scan-back-link" title="Back to home" aria-label="Back to home">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </a>
            <h1 class="scan-header-title">Delivery Orders</h1>
        </div>
        <div class="scan-header-actions">
            <div class="scan-menu-wrap">
                <button class="scan-menu-btn" id="scanMenuBtn" type="button" aria-expanded="false" aria-controls="scanMenuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="scanMenuPanel" class="scan-menu-panel" aria-hidden="true">
                    <div class="scan-menu-user">@userName</div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "scan-menu-link" })
                    <form method="post" asp-page="/Logout" class="scan-menu-signout">
                        <button type="submit" class="scan-menu-link scan-menu-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="scan-header-tabs">
        <partial name="_ScanSoModuleTabs" model='"scan"' />
    </div>
</header>

<main class="scan-main">
    <div class="scan-main-inner">
        @if (TempData["ScanSoSubmitMessage"] is string submitMsg && !string.IsNullOrWhiteSpace(submitMsg))
        {
            <p class="scan-flash scan-flash--ok" role="status">@submitMsg</p>
        }
        @if (TempData["ScanSoSubmitError"] is string submitError && !string.IsNullOrWhiteSpace(submitError))
        {
            <p class="scan-flash scan-flash--error" role="alert">@submitError</p>
        }

        <div class="scan-search-bar">
            <input id="scanSoSearch" class="scan-search-input" type="search" placeholder="Search SO #…" autocomplete="off" />
            <span id="scanSoResultCount" class="scan-result-count"></span>
        </div>

        <div class="scan-seg" role="tablist" aria-label="Delivery progress">
            <button type="button" class="scan-seg-btn is-active" data-filter="outstanding" role="tab" aria-selected="true">Outstanding</button>
            <button type="button" class="scan-seg-btn" data-filter="delivered" role="tab" aria-selected="false">Fully delivered</button>
        </div>

        <div class="scan-table-wrap">
            <table class="scan-table scan-table--list">
                <thead>
                    <tr>
                        <th>SO #</th>
                        <th>Progress</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody id="scanSoTableBody">
                    <tr class="scan-row scan-row--loading"><td colspan="3">Loading…</td></tr>
                </tbody>
            </table>
        </div>
        <div id="scanSoEmpty" class="scan-empty" hidden>
            <p>No approved sales orders in this view.</p>
        </div>
        <div id="scanSoListSentinel" aria-hidden="true"></div>
    </div>
</main>

<script src="~/js/scan-menu.js" asp-append-version="true"></script>
<script src="~/js/scan-so.js" asp-append-version="true"></script>
