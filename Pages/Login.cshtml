@page
@model ApprovalPO.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    var sub = Model.Subscription;
    if (sub.Expired)
        ViewData["BodyClass"] = "login-page-body is-license-expired";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

@if (sub.Expired)
{
    <div class="login-license-lockout" role="alertdialog" aria-modal="true" aria-labelledby="login-license-lockout-title">
        <div class="login-license-lockout__card">
            <div class="login-license-lockout__emoji" aria-hidden="true">🔒</div>
            <h1 id="login-license-lockout-title" class="login-license-lockout__title">@(string.IsNullOrEmpty(sub.Title) ? "Subscription Expired" : sub.Title)</h1>
            <p class="login-license-lockout__lead">@(string.IsNullOrEmpty(sub.Body) ? "Your subscription has expired." : sub.Body)</p>
            <p class="login-license-lockout__hint">@(string.IsNullOrEmpty(sub.Detail) ? "Please contact ProAcc System to renew your subscription and restore access." : sub.Detail)</p>
            @if (!string.IsNullOrEmpty(sub.WhatsAppUrl))
            {
                <a class="login-license-wa" href="@sub.WhatsAppUrl" target="_blank" rel="noopener noreferrer">Contact Support</a>
            }
        </div>
    </div>
}

<div class="landing-shell@(sub.Expired ? " is-license-expired" : "")">
    <div class="landing-page" id="landingPage">

        <aside class="landing-aside" aria-label="Welcome">
            <div class="landing-aside-inner">
                <img src="~/eapproval_logo.png"
                     alt="ProAcc e-Approval"
                     class="landing-logo"
                     asp-append-version="true" />
            </div>
        </aside>

        <section class="landing-main">
            <div class="landing-container">
                <input type="hidden" id="returnUrlField" name="ReturnUrl" value="@(Model.ReturnUrl ?? "")" />
                @Html.AntiForgeryToken()

                <div id="idGroup" class="landing-step is-active">
                    <h2 class="step-title">Welcome</h2>
                    <p class="step-subtitle">Enter your email to receive a one-time password.</p>

                    <div id="messageEmail" class="step-error" style="display:none;" role="status"></div>

                    <div class="hp-field" aria-hidden="true">
                        <label for="companyWebsite">Company website</label>
                        <input type="text" id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" data-lpignore="true" inputmode="none" />
                    </div>

                    <div class="form-group">
                        <label for="loginId">Email Address</label>
                        <input type="email"
                               id="loginId"
                               name="loginId"
                               class="step-input"
                               autocomplete="username"
                               inputmode="email"
                               placeholder="your@email.com" />
                    </div>

                    <button id="sendBtn" type="button" class="step-submit">Send OTP</button>

                    <div class="landing-meta">
                        @if (sub.Show && !sub.Expired && !string.IsNullOrEmpty(sub.Title))
                        {
                            <div class="login-license-left" role="status">
                                <div class="login-license-left__title">@sub.Title</div>
                                @if (!string.IsNullOrEmpty(sub.Body))
                                {
                                    <div class="login-license-left__body">@sub.Body</div>
                                }
                                @if (!string.IsNullOrEmpty(sub.WhatsAppUrl))
                                {
                                    <a class="login-license-wa login-license-wa--compact" href="@sub.WhatsAppUrl" target="_blank" rel="noopener noreferrer">Renew Subscription</a>
                                }
                            </div>
                        }
                        <div>Managed by ProAcc System.</div>
                        <div class="landing-version">V 2.3</div>
                        <a class="install-link" href="/downloads/ChainwayC5-RFID.apk" download>Download RFID Scanner</a>
                        <div class="landing-version">Chainway C5 reminder. Other devices can sign in as usual.</div>
                        <button type="button"
                                id="installTrigger"
                                class="install-link"
                                aria-haspopup="dialog"
                                aria-expanded="false">
                            Install app
                        </button>
                    </div>
                </div>

                <div id="otpGroup" class="landing-step">
                    <h2 class="step-title">Verify your email</h2>
                    <p class="step-subtitle">
                        Enter the 6-digit code sent to<br />
                        <span class="step-email-display" id="emailDisplay"></span>
                    </p>

                    <div id="messageOtp" class="step-error" style="display:none;" role="status"></div>

                    <input type="hidden" id="loginIdHidden" />

                    <div class="form-group">
                        <label class="otp-label" for="otp0">Enter OTP</label>
                        <div class="otp-boxes" id="otpBoxes" role="group" aria-label="One time passcode digits">
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp0" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 1" />
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp1" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 2" />
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp2" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 3" />
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp3" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 4" />
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp4" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 5" />
                            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp otp-digit" id="otp5" autocomplete="one-time-code" data-lpignore="true" aria-label="Digit 6" />
                        </div>
                        <div class="otp-hint" id="otpTimer" hidden>OTP expires in <span id="otpCountdown">120</span>s</div>
                    </div>

                    <button id="verifyBtn" type="button" class="step-submit">Verify</button>

                    <div class="otp-footer">
                        <button type="button" id="resendBtn" class="otp-resend" disabled>Resend OTP</button>
                        <a href="#" class="otp-back" id="backToEmail">&larr; Back to email</a>
                    </div>
                </div>

            </div>
        </section>

    </div>
</div>

<div id="installModal" class="install-modal" aria-hidden="true" hidden>
    <div class="install-modal__backdrop" data-install-close></div>
    <div class="install-modal__card" role="dialog" aria-modal="true" aria-labelledby="installModalTitle">
        <div class="install-modal__header">
            <div id="installModalTitle">Install app</div>
            <button type="button" class="install-modal__close" data-install-close aria-label="Close install instructions">×</button>
        </div>
        <div class="install-modal__body">
            <div class="install-section">
                <div class="install-badge">Android · Chrome</div>
                <ol>
                    <li>Tap the ⋮ More menu.</li>
                    <li>
                        Select
                        <button type="button" id="installFromModalBtn" class="install-inline-btn">
                            Add to home screen
                        </button>
                    </li>
                </ol>
                <p id="androidInstallHint" class="install-hint" hidden>
                    Native install prompt is not available yet. Use Chrome menu (⋮) and choose Add to home screen.
                </p>
            </div>
            <div class="install-section">
                <div class="install-badge">iOS · Safari</div>
                <ol>
                    <li>Tap Share.</li>
                    <li>
                        Choose
                        <button type="button" id="installFromIosBtn" class="install-inline-btn">
                            Add to Home Screen
                        </button>
                    </li>
                </ol>
                <p id="iosInstallHint" class="install-hint" hidden>
                    Safari cannot open the install prompt automatically. Tap Share, then Add to Home Screen to create the shortcut.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const OTP_LIFETIME_DEFAULT = 120;
    const RESEND_COOLDOWN_DEFAULT = 30;

    const msgEmail = (t) => {
        const el = document.getElementById('messageEmail');
        if (!el) return;
        if (!t) { el.style.display = 'none'; el.textContent = ''; return; }
        el.className = 'step-error';
        el.style.display = 'block';
        el.textContent = t;
    };
    const msgOtp = (t, kind) => {
        const el = document.getElementById('messageOtp');
        if (!el) return;
        if (!t) { el.style.display = 'none'; el.textContent = ''; return; }
        el.className = kind === 'success' ? 'step-success' : 'step-error';
        el.style.display = 'block';
        el.textContent = t;
    };

    const sendBtn = document.getElementById('sendBtn');
    const verifyBtn = document.getElementById('verifyBtn');
    const resendBtn = document.getElementById('resendBtn');
    const loginIdEl = document.getElementById('loginId');
    const loginHidden = document.getElementById('loginIdHidden');
    const otpInputs = Array.from(document.querySelectorAll('.otp'));
    const idGroup = document.getElementById('idGroup');
    const otpGroup = document.getElementById('otpGroup');
    const otpBoxes = document.getElementById('otpBoxes');
    const landingPage = document.getElementById('landingPage');
    const emailDisplay = document.getElementById('emailDisplay');
    const otpTimer = document.getElementById('otpTimer');

    const csrfToken = () =>
        document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const appendCsrf = (fd) => {
        const t = csrfToken();
        if (t) fd.append('__RequestVerificationToken', t);
    };
    const csrfHeaders = () => {
        const t = csrfToken();
        return t ? { 'X-CSRF-TOKEN': t, 'RequestVerificationToken': t } : {};
    };

    let expiresAtUnix = 0;
    let otpExpired = false;
    let otpTimerId = null;
    let resendCooldownUntil = 0;
    let resendTimerId = null;
    let verifyInFlight = false;

    const stopOtpTimer = () => {
        if (otpTimerId) {
            window.clearInterval(otpTimerId);
            otpTimerId = null;
        }
    };

    const stopResendTimer = () => {
        if (resendTimerId) {
            window.clearInterval(resendTimerId);
            resendTimerId = null;
        }
    };

    const setOtpInputsEnabled = (enabled) => {
        otpInputs.forEach((b) => {
            b.disabled = !enabled;
            b.readOnly = !enabled;
            if (!enabled) b.blur();
        });
        if (verifyBtn) verifyBtn.disabled = !enabled;
        otpBoxes?.classList.toggle('is-locked', !enabled);
    };

    const setExpiredState = () => {
        otpExpired = true;
        otpInputs.forEach((b) => { b.value = ''; b.classList.remove('is-filled'); });
        setOtpInputsEnabled(false);
        stopOtpTimer();
        if (otpTimer) {
            otpTimer.hidden = false;
            otpTimer.classList.add('is-expired');
            otpTimer.innerHTML = 'OTP expired. Use Resend OTP below.';
        }
        updateResendButton();
    };

    const startOtpTimer = (expiresUnix) => {
        stopOtpTimer();
        otpExpired = false;
        setOtpInputsEnabled(true);
        expiresAtUnix = expiresUnix || (Math.floor(Date.now() / 1000) + OTP_LIFETIME_DEFAULT);
        if (otpTimer) {
            otpTimer.hidden = false;
            otpTimer.classList.remove('is-expired');
            otpTimer.innerHTML = 'OTP expires in <span id="otpCountdown">120</span>s';
        }
        const tick = () => {
            const now = Math.floor(Date.now() / 1000);
            const remaining = Math.max(0, expiresAtUnix - now);
            const el = document.getElementById('otpCountdown');
            if (el) el.textContent = String(remaining);
            if (remaining <= 0) setExpiredState();
        };
        tick();
        otpTimerId = window.setInterval(tick, 1000);
    };

    const updateResendButton = () => {
        if (!resendBtn) return;
        const now = Math.floor(Date.now() / 1000);
        const remaining = Math.max(0, resendCooldownUntil - now);
        if (remaining > 0) {
            resendBtn.disabled = true;
            resendBtn.textContent = `Resend in ${remaining}s`;
        } else {
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend OTP';
            stopResendTimer();
        }
    };

    const startResendCooldown = (seconds) => {
        const secs = Math.max(0, parseInt(seconds, 10) || RESEND_COOLDOWN_DEFAULT);
        resendCooldownUntil = Math.floor(Date.now() / 1000) + secs;
        stopResendTimer();
        updateResendButton();
        resendTimerId = window.setInterval(updateResendButton, 1000);
    };

    const showEmailStep = () => {
        stopOtpTimer();
        stopResendTimer();
        otpExpired = false;
        setOtpInputsEnabled(true);
        if (otpTimer) {
            otpTimer.hidden = true;
            otpTimer.classList.remove('is-expired');
        }
        idGroup.classList.add('is-active');
        otpGroup.classList.remove('is-active');
        landingPage?.classList.remove('landing-page--otp');
    };

    const showOtpStep = (email) => {
        loginHidden.value = email;
        if (emailDisplay) emailDisplay.textContent = email;
        idGroup.classList.remove('is-active');
        otpGroup.classList.add('is-active');
        landingPage?.classList.add('landing-page--otp');
        otpInputs[0]?.focus();
    };

    const otpString = () => otpInputs.map((input) => (input.value || '').replace(/\D/g, '').slice(0, 1)).join('');

    const digitFromKeyEvent = (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return null;
      const k = e.key;
      if (k && k.length === 1 && k >= '0' && k <= '9') return k;
      if (e.code) {
        const m = /^Numpad(\d)$/.exec(e.code);
        if (m) return m[1];
      }
      return null;
    };

    const tryAutoVerify = () => {
        if (otpExpired || verifyInFlight) return;
        const otp = otpString();
        if (otp.length === 6 && /^\d{6}$/.test(otp)) {
            void runVerify();
        }
    };

    const runVerify = async () => {
        if (verifyInFlight || otpExpired) return;
        verifyInFlight = true;
        verifyBtn.disabled = true;
        verifyBtn.textContent = 'Verifying...';
        try {
            const loginId = (loginHidden.value || '').trim();
            const otp = otpString();
            if (!loginId) {
                msgOtp('Email missing. Refresh and try again.');
                return;
            }
            if (otp.length !== 6 || !/^\d{6}$/.test(otp)) {
                msgOtp('OTP must be exactly 6 digits.');
                return;
            }
            msgOtp('');
            const fd = new FormData();
            fd.append('LoginId', loginId);
            fd.append('Otp', otp);
            const hp = document.getElementById('companyWebsite');
            if (hp) fd.append('companyWebsite', hp.value || '');
            const ru = document.getElementById('returnUrlField');
            if (ru && ru.value) fd.append('ReturnUrl', ru.value);
            appendCsrf(fd);
            const res = await fetch('@Url.Page("/Login", null, new { handler = "VerifyOtp" })', {
                method: 'POST',
                headers: csrfHeaders(),
                body: fd
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
                let t = data.message || 'Verification failed.';
                if (data.diagnostic) t += '\n\n' + data.diagnostic;
                msgOtp(t);
                otpInputs.forEach((input) => { input.value = ''; input.classList.remove('is-filled'); });
                if (!otpExpired) otpInputs[0]?.focus();
                return;
            }
            window.location.href = data.redirectUrl || '@Url.Page("/PurchaseOrders")';
        } catch {
            msgOtp('Network error.');
        } finally {
            verifyInFlight = false;
            if (!otpExpired) {
                verifyBtn.disabled = false;
                verifyBtn.textContent = 'Verify';
            }
        }
    };

    const runSendOtp = async ({ fromResend = false } = {}) => {
        const loginId = fromResend
            ? (loginHidden.value || loginIdEl.value || '').trim()
            : (loginIdEl.value || '').trim();
        if (!loginId) {
            if (fromResend) msgOtp('Email missing. Go back and enter your email.');
            else msgEmail('Please enter your work email.');
            return;
        }
        if (fromResend) {
            msgOtp('');
            if (resendBtn) resendBtn.disabled = true;
        } else {
            msgEmail('');
            msgOtp('');
            sendBtn.disabled = true;
            sendBtn.textContent = 'Sending...';
        }
        try {
            const fd = new FormData();
            fd.append('LoginId', loginId);
            const hp = document.getElementById('companyWebsite');
            if (hp) fd.append('companyWebsite', hp.value || '');
            appendCsrf(fd);
            const res = await fetch('@Url.Page("/Login", null, new { handler = "SendOtp" })', {
                method: 'POST',
                headers: csrfHeaders(),
                body: fd
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data.success) {
                let t = data.message || 'Could not send OTP.';
                if (data.diagnostic) t += '\n\n' + data.diagnostic;
                if (fromResend) {
                    msgOtp(t);
                    if (data.cooldownRemainingSeconds) startResendCooldown(data.cooldownRemainingSeconds);
                    else updateResendButton();
                } else {
                    msgEmail(t);
                }
                return;
            }
            showOtpStep(loginId);
            startOtpTimer(data.expiresAtUnix);
            startResendCooldown(data.resendCooldownSeconds || RESEND_COOLDOWN_DEFAULT);
            msgOtp(fromResend ? 'New OTP sent.' : (data.message || 'OTP sent successfully'), 'success');
            otpInputs.forEach((input) => { input.value = ''; input.classList.remove('is-filled'); });
            const d = (data.devOtp || '').toString().trim();
            if (/^\d{6}$/.test(d)) {
                for (let i = 0; i < 6; i++) {
                    otpInputs[i].value = d[i];
                    otpInputs[i].classList.add('is-filled');
                }
                tryAutoVerify();
            } else {
                otpInputs[0]?.focus();
            }
        } catch {
            if (fromResend) {
                msgOtp('Network error.');
                updateResendButton();
            } else {
                msgEmail('Network error.');
            }
        } finally {
            if (!fromResend) {
                sendBtn.disabled = false;
                sendBtn.textContent = 'Send OTP';
            }
        }
    };

    document.getElementById('backToEmail')?.addEventListener('click', (e) => {
        e.preventDefault();
        msgOtp('');
        otpInputs.forEach((input) => { input.value = ''; input.classList.remove('is-filled'); });
        showEmailStep();
    });

    sendBtn.addEventListener('click', () => void runSendOtp({ fromResend: false }));
    resendBtn?.addEventListener('click', () => {
        if (resendBtn.disabled) return;
        void runSendOtp({ fromResend: true });
    });

    loginIdEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            void runSendOtp({ fromResend: false });
        }
    });

    otpBoxes.addEventListener('keydown', (e) => {
        const el = e.target;
        if (!el.classList?.contains('otp')) return;
        if (otpExpired || el.disabled) { e.preventDefault(); return; }
        const idx = otpInputs.indexOf(el);
        if (idx < 0) return;

        if (e.key === 'Backspace') {
            if (!el.value && idx > 0) {
                e.preventDefault();
                otpInputs[idx - 1].focus();
                otpInputs[idx - 1].value = '';
                otpInputs[idx - 1].classList.remove('is-filled');
            }
            return;
        }

        if (e.key === 'Enter' || e.code === 'NumpadEnter') {
            e.preventDefault();
            if (otpString().length === 6) void runVerify();
            return;
        }

        const digit = digitFromKeyEvent(e);
        if (digit) {
            e.preventDefault();
            el.value = digit;
            el.classList.add('is-filled');
            if (idx < otpInputs.length - 1) {
                otpInputs[idx + 1].focus();
            } else {
                el.blur();
            }
            tryAutoVerify();
        }
    });

    otpInputs.forEach((input, idx, arr) => {
        input.addEventListener('input', () => {
            if (otpExpired || input.disabled) { input.value = ''; return; }
            const digits = (input.value || '').replace(/\D/g, '');
            input.value = digits.slice(-1);
            input.classList.toggle('is-filled', !!input.value);
            if (input.value && idx < arr.length - 1) {
                arr[idx + 1].focus();
            }
            tryAutoVerify();
        });

        input.addEventListener('paste', (e) => {
            if (otpExpired || input.disabled) { e.preventDefault(); return; }
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData).getData('text') || '';
            const digits = text.replace(/\D/g, '').slice(0, 6);
            if (!digits) return;
            digits.split('').forEach((ch, i) => {
                if (arr[i]) {
                    arr[i].value = ch;
                    arr[i].classList.add('is-filled');
                }
            });
            const next = Math.min(digits.length, arr.length - 1);
            arr[next].focus();
            tryAutoVerify();
        });
    });

    verifyBtn.addEventListener('click', () => void runVerify());
})();
</script>
<script>
(() => {
    let deferredPrompt = null;
    let canInstall = false;
    let isInstalled = false;

    const modal = document.getElementById('installModal');
    const trigger = document.getElementById('installTrigger');
    const installFromModalBtn = document.getElementById('installFromModalBtn');
    const installFromIosBtn = document.getElementById('installFromIosBtn');
    const androidInstallHint = document.getElementById('androidInstallHint');
    const iosInstallHint = document.getElementById('iosInstallHint');
    const body = document.body;

    if (!modal || !trigger) {
        return;
    }

    const isIosSafari = () => {
        const ua = window.navigator.userAgent;
        const isIOS = /iphone|ipad|ipod/i.test(ua);
        const isWebKit = /webkit/i.test(ua);
        const isCriOS = /crios/i.test(ua);
        const isFxiOS = /fxios/i.test(ua);
        return isIOS && isWebKit && !isCriOS && !isFxiOS;
    };

    const updateInstallVisibility = () => {
        trigger.hidden = isInstalled;
    };

    const standaloneDisplay = window.matchMedia('(display-mode: standalone)').matches;
    const iosStandalone = window.navigator.standalone === true;
    isInstalled = standaloneDisplay || iosStandalone;
    updateInstallVisibility();

    const closeTargets = modal.querySelectorAll('[data-install-close]');

    const openModal = () => {
        modal.hidden = false;
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        trigger.setAttribute('aria-expanded', 'true');
        body.classList.add('modal-open');
    };

    const closeModal = () => {
        modal.hidden = true;
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        trigger.setAttribute('aria-expanded', 'false');
        body.classList.remove('modal-open');
    };

    const openIosShareSheet = async () => {
        if (!isIosSafari() || typeof navigator.share !== 'function') {
            return false;
        }

        try {
            await navigator.share({
                title: document.title,
                text: 'Open the Share menu and choose Add to Home Screen.',
                url: window.location.href
            });
            return true;
        } catch (_) {
            return false;
        }
    };

    const handleInstallClick = async (showFallbackModal = true, hintTarget = 'none') => {
        if (androidInstallHint) androidInstallHint.hidden = true;
        if (iosInstallHint) iosInstallHint.hidden = true;

        if (deferredPrompt) {
            await deferredPrompt.prompt();
            try {
                const choice = await deferredPrompt.userChoice;
                if (choice.outcome === 'accepted') {
                    canInstall = false;
                }
            } catch (_) {
            }

            deferredPrompt = null;
            canInstall = false;
            updateInstallVisibility();
            return;
        }

        if (!isInstalled && showFallbackModal) {
            openModal();
        }

        if (!isInstalled && hintTarget === 'android' && androidInstallHint) {
            androidInstallHint.hidden = false;
        }

        if (!isInstalled && hintTarget === 'ios' && iosInstallHint) {
            const shareOpened = await openIosShareSheet();
            iosInstallHint.textContent = shareOpened
                ? 'Share menu opened. Tap Add to Home Screen to create the shortcut.'
                : 'Safari cannot open the install prompt automatically. Tap Share, then Add to Home Screen to create the shortcut.';
            iosInstallHint.hidden = false;
        }
    };

    window.addEventListener('beforeinstallprompt', (event) => {
        event.preventDefault();
        deferredPrompt = event;
        canInstall = true;
        updateInstallVisibility();
    });

    window.addEventListener('appinstalled', () => {
        isInstalled = true;
        canInstall = false;
        deferredPrompt = null;
        closeModal();
        updateInstallVisibility();
    });

    trigger.addEventListener('click', () => handleInstallClick());
    installFromModalBtn?.addEventListener('click', () => handleInstallClick(true, 'android'));
    installFromIosBtn?.addEventListener('click', () => handleInstallClick(false, 'ios'));
    closeTargets.forEach((el) => el.addEventListener('click', closeModal));

    document.addEventListener('keydown', (evt) => {
        if (evt.key === 'Escape') {
            closeModal();
        }
    });
})();
</script>
}
