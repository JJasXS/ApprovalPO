@page
@model ApprovalPO.Pages.DashboardModel
@{
    ViewData["Title"] = "Home";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-shell">
    <header class="dash-header">
        <div class="dash-header-inner">
            <div class="dash-brand">
                <svg class="dash-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span class="dash-brand-name">ProAcc Approvals</span>
            </div>
            <div class="dash-header-actions">
                <span class="dash-header-user">@userName</span>
                <partial name="_LogoutForm" />
            </div>
        </div>
    </header>

    <main class="dash-main">
        <div class="dash-welcome">
            <h1 class="dash-welcome-title">What would you like to do?</h1>
            <p class="dash-welcome-sub">Select a module to get started.</p>
        </div>

        <div class="dash-cards">

            <!-- Purchase Approval -->
            @if (Model.ShowPurchaseApproval)
            {
            <a href="/PurchaseOrders" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Purchase Approval</h2>
                    <p class="dash-card-desc">Review and approve pending purchase orders from your team.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Sales Approval -->
            @if (Model.ShowSalesApproval)
            {
            <a href="/SalesOrders" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Sales Approval</h2>
                    <p class="dash-card-desc">Manage and approve sales orders and quotations.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Goods Received -->
            @if (Model.ShowScanPo || Model.ShowReceivedGoods)
            {
            <a asp-page="/ScanPO" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="3" y="16" width="5" height="5" rx="1"/>
                        <path d="M21 16h-3a2 2 0 0 0-2 2v3"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="12" y1="3" x2="12" y2="6"/><path d="M12 12v3h3"/><line x1="12" y1="21" x2="12" y2="18"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Goods Received</h2>
                    <p class="dash-card-desc">Scan QR codes to look up purchase orders and view goods received.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Maintenance Scanner -->
            @if (Model.ShowMaintenanceScanner)
            {
            <a asp-page="/MaintenanceScanner/Index" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="6" width="18" height="12" rx="1"/>
                        <line x1="6" y1="9" x2="6" y2="15"/>
                        <line x1="9" y1="9" x2="9" y2="15"/>
                        <line x1="12" y1="9" x2="12" y2="15"/>
                        <line x1="15" y1="9" x2="15" y2="15"/>
                        <line x1="18" y1="9" x2="18" y2="15"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Maintenance Scanner</h2>
                    <p class="dash-card-desc">Scan stock item barcodes, confirm location, and log maintenance activity.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            @if (!Model.HasAnyModule)
            {
                <div class="dash-card" style="pointer-events:none;opacity:.82;">
                    <div class="dash-card-body">
                        <h2 class="dash-card-title">No modules available</h2>
                        <p class="dash-card-desc">Your role or tenant configuration has no modules enabled. Contact your administrator if you need access.</p>
                    </div>
                </div>
            }

        </div>
        @if (Model.ShowScanPo || Model.ShowReceivedGoods)
        {
            <p class="dash-rfid-download">
                <a href="/downloads/ChainwayC5-RFID.apk" download>Download RFID Scanner</a>
                Chainway C5 only. Desktop and other phones do not need this app.
            </p>
        }
    </main>
</div>
