@page
@model ApprovalPO.Pages.DashboardModel
@{
    ViewData["Title"] = "Home";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-shell">
    <header class="dash-header">
        <div class="dash-header-inner">
            <div class="dash-brand">
                <svg class="dash-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span class="dash-brand-name">ProAcc Approvals</span>
            </div>
            <div class="dash-header-actions">
                <button id="menuBtn" class="dash-menu-btn" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="menuPanel" class="dash-menu-panel" aria-hidden="true">
                    <div class="dash-menu-user">@userName</div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "dash-menu-link" })
                    <form method="post" asp-page="/Logout" class="dash-menu-signout">
                        <button type="submit" class="dash-menu-link dash-menu-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dash-main">
        <div class="dash-board">
        <div class="dash-overview">
            <p class="dash-overview-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
            <h1 class="dash-overview-title">Overview</h1>
        </div>

        @if (Model.HasOverview)
        {
            <section class="dash-insight" aria-label="Overview">
                <div class="dash-chart-card" id="dashTrend" data-trend='@Html.Raw(Model.TrendJson)'>
                    <div class="dash-chart-head">
                        <h2 class="dash-chart-title">Last 7 days</h2>
                        <p class="dash-chart-sub">Purchase, sales, goods &amp; delivery volume</p>
                    </div>
                    <div class="dash-graph-frame" id="dashTrendGraph"></div>
                    <div class="dash-graph-legend" aria-hidden="true"></div>
                </div>

                <div class="dash-tabs" data-dash-tabs>
                    <div class="dash-tablist" role="tablist" aria-label="Overview panels">
                        <button type="button" class="dash-tab is-active" role="tab" aria-selected="true" data-dash-tab="summary">Summary</button>
                    </div>
                    <div class="dash-tabpanels">
                        <div class="dash-tabpanel is-active" role="tabpanel" data-dash-panel="summary">
                            <ul class="dash-indicators">
                                @foreach (var fig in Model.Figures)
                                {
                                    var color = Model.Trend.Series.FirstOrDefault(s => s.Key == fig.Key)?.Color ?? "#64748b";
                                    <li>
                                        <a class="dash-indicator" href="@fig.Href">
                                            <span class="dash-indicator-dot" style="--dash-dot:@color"></span>
                                            <span class="dash-indicator-copy">
                                                <span class="dash-indicator-label">@fig.Label</span>
                                                <span class="dash-indicator-meta">
                                                    @(fig.Count is int n ? n.ToString("N0") : "—")
                                                    @DashboardModel.IndicatorUnit(fig.Key)
                                                    ·
                                                    @(fig.Amount is decimal a ? a.ToString("N2") : "—")
                                                </span>
                                            </span>
                                            <span class="dash-indicator-go" aria-hidden="true">›</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        }

        <div class="dash-cards">

            <!-- Purchase Approval -->
            @if (Model.ShowPurchaseApproval)
            {
            <a href="/PurchaseOrders" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Purchase Approval</h2>
                    <p class="dash-card-desc">@DashboardModel.CardLine(Model.Figure("purchase"), "pending")</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Sales Approval -->
            @if (Model.ShowSalesApproval)
            {
            <a href="/SalesOrders" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Sales Approval</h2>
                    <p class="dash-card-desc">@DashboardModel.CardLine(Model.Figure("sales"), "pending")</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Goods Received -->
            @if (Model.ShowScanPo || Model.ShowReceivedGoods)
            {
            <a href="@Model.GoodsHref" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="3" y="16" width="5" height="5" rx="1"/>
                        <path d="M21 16h-3a2 2 0 0 0-2 2v3"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="12" y1="3" x2="12" y2="6"/><path d="M12 12v3h3"/><line x1="12" y1="21" x2="12" y2="18"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Goods Received</h2>
                    <p class="dash-card-desc">@DashboardModel.CardLine(Model.Figure("goods"), "receipts")</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Delivery Orders (SO → DO) -->
            @if (Model.ShowScanSo || Model.ShowDeliveryOrders)
            {
            <a href="@Model.DeliveryHref" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13" rx="1"/>
                        <path d="M16 8h4l3 3v5h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Delivery Orders</h2>
                    <p class="dash-card-desc">Deliver approved sales orders and track progress.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            <!-- Maintenance Scanner -->
            @if (Model.ShowMaintenanceScanner)
            {
            <a asp-page="/MaintenanceScanner/Index" class="dash-card dash-card--active">
                <div class="dash-card-icon-wrap dash-card-icon-wrap--teal">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="6" width="18" height="12" rx="1"/>
                        <line x1="6" y1="9" x2="6" y2="15"/>
                        <line x1="9" y1="9" x2="9" y2="15"/>
                        <line x1="12" y1="9" x2="12" y2="15"/>
                        <line x1="15" y1="9" x2="15" y2="15"/>
                        <line x1="18" y1="9" x2="18" y2="15"/>
                    </svg>
                </div>
                <div class="dash-card-body">
                    <h2 class="dash-card-title">Maintenance Scanner</h2>
                    <p class="dash-card-desc">Scan stock item barcodes, confirm location, and log maintenance activity.</p>
                </div>
                <div class="dash-card-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
            </a>
            }

            @if (!Model.HasAnyModule)
            {
                <div class="dash-card" style="pointer-events:none;opacity:.82;">
                    <div class="dash-card-body">
                        <h2 class="dash-card-title">No modules available</h2>
                        <p class="dash-card-desc">Your role or tenant configuration has no modules enabled. Contact your administrator if you need access.</p>
                    </div>
                </div>
            }

        </div>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
