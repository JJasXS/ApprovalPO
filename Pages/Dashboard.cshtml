@page
@model ApprovalPO.Pages.DashboardModel
@{
    ViewData["Title"] = "Home";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-shell">
    <header class="dash-header">
        <div class="dash-header-inner">
            <div class="dash-brand">
                <svg class="dash-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <span class="dash-brand-name">ProAcc Approvals</span>
            </div>
            <div class="dash-header-actions">
                <button id="menuBtn" class="dash-menu-btn" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="menuPanel" class="dash-menu-panel" aria-hidden="true">
                    <div class="dash-menu-user">@userName</div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "dash-menu-link" })
                    <form method="post" asp-page="/Logout" class="dash-menu-signout">
                        <button type="submit" class="dash-menu-link dash-menu-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dash-main">
        <div class="dash-board">
        <div class="dash-overview">
            <p class="dash-overview-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</p>
            <h1 class="dash-overview-title">Overview</h1>
        </div>

        @{
            var showSummaryTab = Model.HasOverview;
            var showActionTab = Model.HasAnyModule;
            var defaultTab = showActionTab ? "action" : "summary";
        }

        @if (Model.HasOverview)
        {
            <section class="dash-insight" aria-label="Overview chart">
                <div class="dash-chart-card" id="dashTrend" data-trend='@Html.Raw(Model.TrendJson)' data-range="7">
                    <div class="dash-chart-head">
                        <div class="dash-chart-head-text">
                            <h2 class="dash-chart-title" data-dash-title>Last 7 days</h2>
                            <p class="dash-chart-sub">Purchase, sales, goods &amp; delivery volume</p>
                        </div>
                        <div class="dash-range" role="group" aria-label="Trend range">
                            <button type="button" class="dash-range-btn is-active" data-range="7">7D</button>
                            <button type="button" class="dash-range-btn" data-range="30">30D</button>
                            <button type="button" class="dash-range-btn" data-range="90">90D</button>
                            <button type="button" class="dash-range-btn" data-range="100">100D</button>
                        </div>
                    </div>
                    <div class="dash-graph-frame" id="dashTrendGraph"></div>
                    <div class="dash-graph-legend" aria-hidden="true"></div>
                </div>
            </section>
        }

        @if (showSummaryTab || showActionTab)
        {
            <div class="dash-tabs" data-dash-tabs data-default-tab="@defaultTab">
                <div class="dash-tablist" role="tablist" aria-label="Overview panels">
                    @if (showSummaryTab)
                    {
                        <button type="button"
                                class="dash-tab @(defaultTab == "summary" ? "is-active" : "")"
                                role="tab"
                                aria-selected="@(defaultTab == "summary" ? "true" : "false")"
                                data-dash-tab="summary">Summary</button>
                    }
                    @if (showActionTab)
                    {
                        <button type="button"
                                class="dash-tab @(defaultTab == "action" ? "is-active" : "")"
                                role="tab"
                                aria-selected="@(defaultTab == "action" ? "true" : "false")"
                                data-dash-tab="action">Action</button>
                    }
                </div>
                <div class="dash-tabpanels">
                    @if (showSummaryTab)
                    {
                        <div class="dash-tabpanel @(defaultTab == "summary" ? "is-active" : "")"
                             role="tabpanel"
                             data-dash-panel="summary"
                             @Html.Raw(defaultTab == "summary" ? "" : "hidden")>
                            <ul class="dash-indicators">
                                @foreach (var fig in Model.Figures)
                                {
                                    var color = Model.Trend.Series.FirstOrDefault(s => s.Key == fig.Key)?.Color ?? "#64748b";
                                    <li>
                                        <a class="dash-indicator" href="@fig.Href">
                                            <span class="dash-indicator-dot" style="--dash-dot:@color"></span>
                                            <span class="dash-indicator-copy">
                                                <span class="dash-indicator-label">@fig.Label</span>
                                                <span class="dash-indicator-meta">
                                                    @(fig.Count is int n ? n.ToString("N0") : "—")
                                                    @DashboardModel.IndicatorUnit(fig.Key)
                                                    ·
                                                    @(fig.Amount is decimal a ? a.ToString("N2") : "—")
                                                </span>
                                            </span>
                                            <span class="dash-indicator-go" aria-hidden="true">›</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (showActionTab)
                    {
                        <div class="dash-tabpanel dash-tabpanel--action @(defaultTab == "action" ? "is-active" : "")"
                             role="tabpanel"
                             data-dash-panel="action"
                             @Html.Raw(defaultTab == "action" ? "" : "hidden")>
                            <div class="dash-action-icons" role="list">
                                @if (Model.ShowPurchaseApproval)
                                {
                                    <a href="/PurchaseOrders" class="dash-action-icon" role="listitem" aria-label="Purchase Approval">
                                        <span class="dash-card-icon-wrap dash-card-icon-wrap--blue">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                                                <line x1="3" y1="6" x2="21" y2="6"/>
                                                <path d="M16 10a4 4 0 0 1-8 0"/>
                                            </svg>
                                        </span>
                                        <span class="dash-action-icon-label">Purchase</span>
                                    </a>
                                }

                                @if (Model.ShowSalesApproval)
                                {
                                    <a href="/SalesOrders" class="dash-action-icon" role="listitem" aria-label="Sales Approval">
                                        <span class="dash-card-icon-wrap dash-card-icon-wrap--green">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <line x1="12" y1="1" x2="12" y2="23"/>
                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                            </svg>
                                        </span>
                                        <span class="dash-action-icon-label">Sales</span>
                                    </a>
                                }

                                @if (Model.ShowScanPo || Model.ShowReceivedGoods)
                                {
                                    <a href="@Model.GoodsHref" class="dash-action-icon" role="listitem" aria-label="Goods Received">
                                        <span class="dash-card-icon-wrap dash-card-icon-wrap--violet">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="3" y="3" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="3" y="16" width="5" height="5" rx="1"/>
                                                <path d="M21 16h-3a2 2 0 0 0-2 2v3"/><line x1="21" y1="21" x2="21" y2="21.01"/><line x1="12" y1="3" x2="12" y2="6"/><path d="M12 12v3h3"/><line x1="12" y1="21" x2="12" y2="18"/>
                                            </svg>
                                        </span>
                                        <span class="dash-action-icon-label">Goods</span>
                                    </a>
                                }

                                @if (Model.ShowScanSo || Model.ShowDeliveryOrders)
                                {
                                    <a href="@Model.DeliveryHref" class="dash-action-icon" role="listitem" aria-label="Delivery Orders">
                                        <span class="dash-card-icon-wrap dash-card-icon-wrap--green">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="1" y="3" width="15" height="13" rx="1"/>
                                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                                <circle cx="18.5" cy="18.5" r="2.5"/>
                                            </svg>
                                        </span>
                                        <span class="dash-action-icon-label">Delivery</span>
                                    </a>
                                }

                                @if (Model.ShowMaintenanceScanner)
                                {
                                    <a asp-page="/MaintenanceScanner/Index" class="dash-action-icon" role="listitem" aria-label="Maintenance Scanner">
                                        <span class="dash-card-icon-wrap dash-card-icon-wrap--teal">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="3" y="6" width="18" height="12" rx="1"/>
                                                <line x1="6" y1="9" x2="6" y2="15"/>
                                                <line x1="9" y1="9" x2="9" y2="15"/>
                                                <line x1="12" y1="9" x2="12" y2="15"/>
                                                <line x1="15" y1="9" x2="15" y2="15"/>
                                                <line x1="18" y1="9" x2="18" y2="15"/>
                                            </svg>
                                        </span>
                                        <span class="dash-action-icon-label">Scanner</span>
                                    </a>
                                }

                                @if (!Model.HasAnyModule)
                                {
                                    <p class="dash-action-empty">No modules available.</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/lib/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
