@page "/ScanDeliveredDetail"
@model ApprovalPO.Pages.ScanDeliveredDetailModel
@{
    ViewData["Title"] = Model.Order?.DoNumber ?? "Delivery order";
    ViewData["AppName"] = "Approval PO";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />

<header class="scan-header">
    <div class="scan-header-inner">
        <div class="scan-header-titles">
            <a asp-page="/DeliveryOrders" class="scan-back-link" title="Back to list">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </a>
            <div>
                <h1 class="scan-header-title">@(Model.Order?.DoNumber ?? "Delivery order")</h1>
                @if (Model.Order is not null)
                {
                    <p class="scan-header-subtitle scan-header-po">@(string.IsNullOrWhiteSpace(Model.Order.SoNumber) ? "—" : Model.Order.SoNumber)</p>
                }
            </div>
        </div>
        <div class="scan-header-actions">
            <div class="scan-menu-wrap">
                <button class="scan-menu-btn" id="scanMenuBtn" type="button" aria-expanded="false" aria-controls="scanMenuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="scanMenuPanel" class="scan-menu-panel" aria-hidden="true">
                    <div class="scan-menu-user">@userName</div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "scan-menu-link" })
                    <form method="post" asp-page="/Logout" class="scan-menu-signout">
                        <button type="submit" class="scan-menu-link scan-menu-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="scan-main scan-main--detail">
    <div class="scan-main-inner">
        @if (Model.Order is null)
        {
            <div class="scan-empty">
                <p>Delivery order not found.</p>
            </div>
        }
        else
        {
            var r = Model.Order;
            <div class="scan-detail-meta">
                <div class="scan-detail-field">
                    <label>Date</label>
                    <span>@r.DoDate.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>
                <div class="scan-detail-field">
                    <label>Amount</label>
                    <span>@r.Amount.ToString("N2")</span>
                </div>
                <div class="scan-detail-field scan-detail-field--manual">
                    <label>Customer</label>
                    <span>@(string.IsNullOrWhiteSpace(r.Customer) ? "—" : r.Customer)</span>
                </div>
                <div class="scan-detail-field scan-detail-field--manual">
                    <label>Description</label>
                    <span>@(string.IsNullOrWhiteSpace(r.Description) ? "—" : r.Description)</span>
                </div>
            </div>

            <div class="scan-table-wrap">
                <table class="scan-table scan-lines-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                <div class="scan-line-code">@line.ItemCode</div>
                                <div class="scan-line-desc">@line.Description</div>
                            </td>
                            <td>@line.Qty.ToString("0.####")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</main>

<script src="~/js/scan-menu.js" asp-append-version="true"></script>
