@page "/ApprovalsStatus"
@model ApprovalPO.Pages.ApprovalsStatusModel
@{
    ViewData["Title"] = $"{Model.StatusFilter} approvals";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dash-shell">
    <header class="dash-header">
        <div class="dash-header-inner">
            <div class="dash-brand">
                <a asp-page="/Dashboard" class="dash-back-link" title="Back to home" aria-label="Back to home">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </a>
                <span class="dash-brand-name">@Model.StatusFilter</span>
            </div>
            <div class="dash-header-actions">
                <button id="menuBtn" class="dash-menu-btn" type="button" aria-expanded="false" aria-controls="menuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="menuPanel" class="dash-menu-panel app-menu-panel" aria-hidden="true">
                    <div class="dash-menu-user app-menu-user">
                        <span class="app-menu-avatar" aria-hidden="true">@((userName?.Trim().Length > 0 ? char.ToUpperInvariant(userName.Trim()[0]) : 'U'))</span>
                        <div class="app-menu-user-copy">
                            <span class="app-menu-kicker">Signed in</span>
                            <span class="app-menu-name">@userName</span>
                        </div>
                    </div>
                    @await Component.InvokeAsync("ModuleNav", new { linkClass = "dash-menu-link" })
                    <form method="post" asp-page="/Logout" class="dash-menu-signout app-menu-signout">
                        <button type="submit" class="dash-menu-link dash-menu-link--danger app-nav-link app-nav-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dash-main">
        <div class="dash-board">
            @await Component.InvokeAsync("CompanyTabs")

            <div class="dash-overview">
                <p class="dash-overview-date">Purchase and Sales · @Model.StatusFilter</p>
                <h1 class="dash-overview-title">@Model.StatusFilter approvals</h1>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <p class="dash-status-error" role="alert">@Model.LoadError</p>
            }
            else
            {
                @if (Model.ShowPurchase)
                {
                    <section class="dash-status-section" aria-labelledby="dashStatusPurchaseTitle">
                        <div class="dash-status-section-head">
                            <h2 id="dashStatusPurchaseTitle" class="dash-section-title">Purchase</h2>
                            <a class="dash-status-section-link" href="/PurchaseOrders?status=@Uri.EscapeDataString(Model.StatusFilter)">Open list</a>
                        </div>
                        @if (Model.PurchaseRows.Count == 0)
                        {
                            <p class="dash-status-empty">No @Model.StatusFilter.ToLowerInvariant() purchase orders.</p>
                        }
                        else
                        {
                            <ul class="dash-status-list">
                                @foreach (var row in Model.PurchaseRows)
                                {
                                    <li>
                                        <a class="dash-status-item" href="/PurchaseOrders?status=@Uri.EscapeDataString(Model.StatusFilter)">
                                            <span class="dash-status-item-main">
                                                <span class="dash-status-item-ref">@(string.IsNullOrWhiteSpace(row.PoNumber) ? $"PO-{row.DocKey}" : row.PoNumber)</span>
                                                <span class="dash-status-item-party">@(string.IsNullOrWhiteSpace(row.Vendor) ? "—" : row.Vendor)</span>
                                            </span>
                                            <span class="dash-status-item-meta">
                                                <span class="dash-status-item-amt">@row.Amount.ToString("N2")</span>
                                                <span class="dash-status-item-date">@row.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                @if (Model.ShowSales)
                {
                    <section class="dash-status-section" aria-labelledby="dashStatusSalesTitle">
                        <div class="dash-status-section-head">
                            <h2 id="dashStatusSalesTitle" class="dash-section-title">Sales</h2>
                            <a class="dash-status-section-link" href="/SalesOrders?status=@Uri.EscapeDataString(Model.StatusFilter)">Open list</a>
                        </div>
                        @if (Model.SalesRows.Count == 0)
                        {
                            <p class="dash-status-empty">No @Model.StatusFilter.ToLowerInvariant() sales orders.</p>
                        }
                        else
                        {
                            <ul class="dash-status-list">
                                @foreach (var row in Model.SalesRows)
                                {
                                    <li>
                                        <a class="dash-status-item" href="/SalesOrders?status=@Uri.EscapeDataString(Model.StatusFilter)">
                                            <span class="dash-status-item-main">
                                                <span class="dash-status-item-ref">@(string.IsNullOrWhiteSpace(row.SoNumber) ? $"SO-{row.DocKey}" : row.SoNumber)</span>
                                                <span class="dash-status-item-party">@(string.IsNullOrWhiteSpace(row.Customer) ? "—" : row.Customer)</span>
                                            </span>
                                            <span class="dash-status-item-meta">
                                                <span class="dash-status-item-amt">@row.Amount.ToString("N2")</span>
                                                <span class="dash-status-item-date">@row.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                            </span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }
            }
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/scan-menu.js" asp-append-version="true"></script>
}
