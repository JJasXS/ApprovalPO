@page "/ScanPODetail"
@model ApprovalPO.Pages.ScanPODetailModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var csrf = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    ViewData["Title"] = Model.Order?.PoNumber ?? "PO detail";
    ViewData["AppName"] = "Approval PO";
    var userName = User.Identity?.Name ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "User";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/scan.css" asp-append-version="true" />

<header class="scan-header">
    <div class="scan-header-inner">
        <div class="scan-header-titles">
            <a asp-page="/ScanPO" class="scan-back-link" title="Back to list">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </a>
            <h1 class="scan-header-title">@(Model.Order?.PoNumber ?? "Purchase order")</h1>
        </div>
        <div class="scan-header-actions">
            <div class="scan-menu-wrap">
                <button class="scan-menu-btn" id="scanMenuBtn" type="button" aria-expanded="false" aria-controls="scanMenuPanel" aria-label="Open menu">
                    <span></span><span></span><span></span>
                </button>
                <div id="scanMenuPanel" class="scan-menu-panel" hidden>
                    <div class="scan-menu-user">@userName</div>
                    <a asp-page="/ScanPO" class="scan-menu-link">&#8592; Back to PO list</a>
                    <a asp-page="/Dashboard" class="scan-menu-link">Back to home</a>
                    <form method="post" asp-page="/Logout" style="margin:0;padding:0">
                        <button type="submit" class="scan-menu-link scan-menu-link--danger">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</header>

<main class="scan-main scan-main--detail">
    <div class="scan-main-inner">
        @if (Model.Order is null)
        {
            <div class="scan-empty">
                <p>Purchase order not found or not approved.</p>
                <a asp-page="/ScanPO" class="scan-detail-back-btn">Back to list</a>
            </div>
        }
        else
        {
            var o = Model.Order;
            var scanSubmitted = Model.IsScanSubmitted;
            <button type="button"
                    id="scanStatusBar"
                    class="scan-status-bar"
                    data-state="@(scanSubmitted ? "done" : "ready")"
                    aria-pressed="false"
                    aria-label="Pause or resume RFID listening"
                    @(scanSubmitted ? "disabled" : null)>
                <span id="scanStatusMain" class="scan-status-bar-main">@(scanSubmitted ? "Submitted" : "RFID Listening")</span>
            </button>
            @if (!scanSubmitted)
            {
                <p id="scanListenHint" class="scan-listen-hint" hidden>Hold the trigger. Unique tags match as they are typed.</p>
            }
            <div class="scan-detail-meta">
                @if (!scanSubmitted)
                {
                    <div class="scan-meta-menu-wrap">
                        <button type="button"
                                id="scanActionsMenuBtn"
                                class="scan-meta-kebab-btn"
                                aria-label="Scan actions"
                                aria-haspopup="true"
                                aria-expanded="false"
                                aria-controls="scanActionsMenuPanel">
                            <span></span><span></span><span></span>
                        </button>
                        <div id="scanActionsMenuPanel" class="scan-meta-menu-panel" hidden>
                            <button type="button" id="scanUndoLastBtn" class="scan-meta-menu-item" disabled>Undo last scan</button>
                            <button type="button" id="scanResetBtn" class="scan-meta-menu-item scan-meta-menu-item--danger" disabled>Reset scan</button>
                        </div>
                    </div>
                }
                <div class="scan-detail-field scan-detail-field--po-date">
                    <label>PO date</label>
                    <span>@o.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                </div>
                <div class="scan-detail-field scan-detail-field--desc">
                    <label>Description</label>
                    <span>@(string.IsNullOrWhiteSpace(o.Description) ? "â" : o.Description)</span>
                </div>
                <div class="scan-detail-field scan-detail-field--manual">
                    <label>Item code</label>
                    <div class="scan-manual-row">
                        @if (scanSubmitted)
                        {
                            <input type="text" id="scanManualCode" class="scan-manual-input" placeholder="Type item code" autocomplete="off" enterkeyhint="go" disabled />
                            <button type="button" class="scan-manual-btn" id="scanManualBtn" disabled>Go</button>
                        }
                        else
                        {
                            <input type="text" id="scanManualCode" class="scan-manual-input" placeholder="Type item code" autocomplete="off" enterkeyhint="go" />
                            <button type="button" class="scan-manual-btn" id="scanManualBtn">Go</button>
                        }
                    </div>
                    @if (!scanSubmitted)
                    {
                        <p class="scan-rfid-tip">
                            Multi-tag: set the gun to <strong>Inventory / Multi-tag</strong>, HID keyboard, suffix <strong>Enter</strong>.
                            Hold the trigger — unique tags match as they are typed. Verify with <code>?scanDebug=1</code>.
                        </p>
                    }
                </div>
                <div class="scan-detail-field scan-detail-field--scan-only">
                    <div class="scan-detail-scan-row">
                        @if (scanSubmitted)
                        {
                            <button type="button" class="scan-detail-scan-btn" id="scanDetailScanBtn" disabled>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="3" y="16" width="5" height="5" rx="1"/>
                                    <path d="M21 16h-3a2 2 0 0 0-2 2v3"/><line x1="21" y1="21" x2="21" y2="21.01"/>
                                </svg>
                                <span>Scan</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="scan-detail-scan-btn" id="scanDetailScanBtn">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="3" y="3" width="5" height="5" rx="1"/><rect x="16" y="3" width="5" height="5" rx="1"/><rect x="3" y="16" width="5" height="5" rx="1"/>
                                    <path d="M21 16h-3a2 2 0 0 0-2 2v3"/><line x1="21" y1="21" x2="21" y2="21.01"/>
                                </svg>
                                <span>Scan</span>
                            </button>
                            <form method="post" asp-page="/ScanPODetail" asp-page-handler="Submit" class="scan-detail-submit-form" id="scanDetailSubmitForm">
                                <input type="hidden" name="docKey" value="@Model.DocKey" />
                                <input type="hidden" name="scanCountsJson" id="scanCountsJson" value="" />
                                <button type="submit" class="scan-detail-submit-btn" id="scanDetailSubmitBtn">Submit</button>
                            </form>
                        }
                        <span id="scanStatusMeta" class="scan-meta-remaining">@(scanSubmitted ? "0" : Model.Lines.Count.ToString()) remaining</span>
                    </div>
                </div>
            </div>

            <div id="scanDetailConfig" hidden
                 data-doc-key="@Model.DocKey"
                 data-po-number="@(o.PoNumber)"
                 data-is-submitted="@(scanSubmitted ? "true" : "false")"
                 data-require-all-lines="true"
                 data-resolve-scan-url="@Url.Page("/ScanPODetail", null, new { handler = "ResolveScan" })"
                 data-scan-state-url="@Url.Page("/ScanPODetail", null, new { handler = "ScanState" })"
                 data-save-draft-url="@Url.Page("/ScanPODetail", null, new { handler = "SaveDraft" })"
                 data-reset-scan-url="@Url.Page("/ScanPODetail", null, new { handler = "ResetScan" })"
                 data-csrf-token="@csrf"
                 data-submit-form-id="scanDetailSubmitForm"
                 data-scan-counts-input-id="scanCountsJson"></div>

            <div id="scanToastRoot" class="scan-toast-root" aria-live="polite"></div>

            <div class="scan-lines-head">
                <p class="scan-lines-title">Line items (@Model.Lines.Count)</p>
            </div>

            <details class="scan-audit-panel" id="scanAuditPanel" hidden>
                <summary>Activity log</summary>
                <ul class="scan-audit-list" id="scanAuditList"></ul>
            </details>
            @if (Model.Lines.Count == 0)
            {
                <p class="scan-detail-empty-lines">No line items found.</p>
            }
            else
            {
                <div class="scan-table-wrap">
                    <table class="scan-lines-table scan-lines-table--handheld">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Item code</th>
                                <th class="scan-col-desc">Description</th>
                                <th class="scan-col-project">Project</th>
                                <th class="num">PO qty</th>
                                <th class="num scan-th-received">Received</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var n = 0; }
                            @foreach (var line in Model.Lines)
                            {
                                n++;
                                var orderQty = line.Sqty != 0 ? line.Sqty : line.Qty;
                                var fullCode = line.ItemCode ?? "";
                                var shortCode = fullCode.Length > 10 ? "…" + fullCode[^10..] : fullCode;
                                <tr data-line-no="@line.LineNo" data-item-code="@fullCode" data-project="@line.Project" data-order-qty="@orderQty.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <td class="scan-line-num">@n</td>
                                    <td class="scan-line-code" title="@fullCode">
                                        <span class="scan-line-code-short">@shortCode</span>
                                        <span class="scan-line-code-full">@fullCode</span>
                                    </td>
                                    <td class="scan-col-desc">@line.Description</td>
                                    <td class="scan-line-project scan-col-project">@(string.IsNullOrWhiteSpace(line.Project) ? "—" : line.Project)</td>
                                    <td class="num scan-line-order-qty">@orderQty.ToString("N2")</td>
                                    <td class="num scan-line-status">
                                        @if (scanSubmitted)
                                        {
                                            <span class="scan-received-readonly" data-received-display></span>
                                        }
                                        else
                                        {
                                            <input type="number" class="scan-received-input" min="0" step="0.01" inputmode="decimal" placeholder="0" aria-label="Quantity received for @fullCode" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div id="scanUnmatchedWrap" class="scan-unmatched-wrap" hidden>
                    <div class="scan-unmatched-head">
                        <p class="scan-unmatched-title">Not on this PO</p>
                        <button type="button" id="scanUnmatchedClear" class="scan-unmatched-clear">Clear</button>
                    </div>
                    <div class="scan-table-wrap">
                        <table class="scan-unmatched-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Code</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody id="scanUnmatchedBody"></tbody>
                        </table>
                    </div>
                </div>
            }

            @if (TempData["ScanSubmitError"] is string submitError && !string.IsNullOrWhiteSpace(submitError))
            {
                <p class="scan-flash scan-flash--error" role="alert">@submitError</p>
            }


            @if (scanSubmitted)
            {
                <div class="scan-detail-actions">
                    <form method="post" asp-page="/ScanPODetail" asp-page-handler="Reopen" class="scan-detail-reopen-form" id="scanDetailReopenForm">
                        <input type="hidden" name="docKey" value="@Model.DocKey" />
                        <button type="submit" class="scan-detail-reopen-btn">Reopen for scanning</button>
                    </form>
                </div>
            }

            <details id="scanWedgeDebug" class="scan-wedge-debug">
                <summary>Listener debug (add ?scanDebug=1 to auto-open)</summary>
                <p class="scan-wedge-debug-help">
                    Hold the trigger over several tags once. If <strong>Burst pending</strong> / last flush shows only 1 code, the gun is still single-read — fix gun Inventory mode (web app cannot invent tags). If N &gt; 1, batch match is working.
                </p>
                <div class="scan-wedge-debug-grid">
                    <div><span class="scan-wedge-debug-label">Armed</span> <code id="scanDebugArmed">no</code></div>
                    <div><span class="scan-wedge-debug-label">Focus</span> <code id="scanDebugFocus">—</code></div>
                    <div><span class="scan-wedge-debug-label">Burst pending</span> <code id="scanDebugBurst">0</code></div>
                    <div><span class="scan-wedge-debug-label">Last burst size</span> <code id="scanDebugBurstSize">—</code></div>
                    <div class="scan-wedge-debug-wide"><span class="scan-wedge-debug-label">Live buffer</span> <code id="scanDebugBuffer">(empty)</code></div>
                    <div class="scan-wedge-debug-wide"><span class="scan-wedge-debug-label">Last flush</span> <code id="scanDebugLastFlush">(none)</code></div>
                </div>
                <pre id="scanDebugLog" class="scan-wedge-debug-log" aria-live="polite"></pre>
            </details>
        }
    </div>
</main>

<div id="qrOverlay" class="qr-overlay">
    <div class="qr-box">
        <video id="qrVideo" class="qr-video" autoplay muted playsinline></video>
        <canvas id="qrCanvas" class="qr-canvas"></canvas>
        <div class="qr-guide"></div>
        <div class="qr-guide-b"></div>
        <div class="qr-scan-line"></div>
    </div>
    <div id="qrCameraHelp" class="qr-camera-help" hidden>
        <p class="qr-camera-help-title">Camera blocked</p>
        <p class="qr-camera-help-lead"><strong>This app cannot reset camera permission.</strong> Only your browser or phone settings can. Use <strong>Take photo</strong> below, or change permission manually.</p>
        <div class="qr-camera-help-actions">
            <button type="button" id="qrUsePhotoBtn" class="qr-retry-camera-btn">Take photo of QR</button>
            <button type="button" id="qrRetryCameraBtn" class="qr-use-photo-btn" hidden>Try live camera again</button>
        </div>
        <p id="qrCameraPermState" class="qr-camera-perm-state" hidden></p>
        <p class="qr-camera-help-sub">Reset in browser (pick yours):</p>
        <details class="qr-camera-help-details" open>
            <summary>Phone â Chrome / Edge</summary>
            <ol class="qr-camera-help-steps">
                <li>Tap <strong>â®</strong> (menu) â <strong>Settings</strong> â <strong>Site settings</strong> â <strong>Camera</strong> â remove block for this site, or set <strong>Ask</strong>.</li>
                <li>Or: <strong>â®</strong> â <strong>Info</strong> / lock icon on the page â <strong>Permissions</strong> â <strong>Camera</strong> â <strong>Allow</strong>.</li>
                <li>Close this tab, open the scan page again, tap <strong>Scan</strong>.</li>
            </ol>
        </details>
        <details class="qr-camera-help-details">
            <summary>iPhone â Safari</summary>
            <ol class="qr-camera-help-steps">
                <li><strong>Settings</strong> â <strong>Safari</strong> â <strong>Camera</strong> â <strong>Ask</strong> or <strong>Allow</strong>.</li>
                <li>Or on the page: <strong>aA</strong> in the address bar â <strong>Website Settings</strong> â <strong>Camera</strong> â <strong>Allow</strong>.</li>
                <li>Reload the page, then tap <strong>Scan</strong>.</li>
            </ol>
        </details>
        <details class="qr-camera-help-details">
            <summary>PC â Chrome / Edge</summary>
            <ol class="qr-camera-help-steps">
                <li>Click the <strong>lock</strong> left of the address â <strong>Site settings</strong>.</li>
                <li>Find <strong>Camera</strong> â <strong>Allow</strong> (or <strong>Reset permission</strong>, then reload).</li>
                <li>Reload, then tap <strong>Scan</strong>. Use <strong>https://â¦</strong> (HTTPS port) for live camera.</li>
            </ol>
        </details>
    </div>
    <div id="qrPhotoPanel" class="qr-photo-panel" hidden>
        <p class="qr-photo-hint" id="qrPhotoHint">Using HTTP â live camera needs HTTPS. Take a photo of the QR, or open <strong id="qrHttpsLink"></strong></p>
        <button type="button" id="qrPhotoBtn" class="qr-photo-btn">Take photo</button>
        <input type="file" id="qrPhotoInput" accept="image/*" capture="environment" hidden />
    </div>
    <div class="qr-toolbar" id="qrToolbar">
        <button type="button" id="qrTorchBtn" class="qr-tool-btn" hidden aria-label="Toggle flashlight">Light</button>
        <button type="button" id="qrPhotoFallbackBtn" class="qr-tool-btn">Photo</button>
    </div>
    <p id="qrStatus" class="qr-status">Hold QR inside the frame. Move closer if it does not scan.</p>
    <button id="qrCloseBtn" class="qr-close-btn" type="button">Cancel</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script src="~/js/scan-qr-scanner.js" asp-append-version="true"></script>
<script src="~/js/scan-resolve.js" asp-append-version="true"></script>
<script src="~/js/scan-po-detail.js" asp-append-version="true"></script>
<script>
    (function () {
        var link = document.getElementById('qrHttpsLink');
        if (link && !window.isSecureContext) {
            var host = location.hostname || 'localhost';
            var httpsMeta = document.querySelector('meta[name="approval-https-port"]');
            var httpsPort = (httpsMeta && httpsMeta.content) ? httpsMeta.content : '2096';
            var url = 'https://' + host + ':' + httpsPort + location.pathname + location.search;
            link.textContent = url;
            link.style.wordBreak = 'break-all';
        }

        var btn = document.getElementById('scanMenuBtn');
        var panel = document.getElementById('scanMenuPanel');
        var actionsBtn = document.getElementById('scanActionsMenuBtn');
        var actionsPanel = document.getElementById('scanActionsMenuPanel');

        function closeHeaderMenu() {
            if (panel) panel.hidden = true;
            if (btn) btn.setAttribute('aria-expanded', 'false');
        }
        function closeActionsMenu() {
            if (actionsPanel) actionsPanel.hidden = true;
            if (actionsBtn) actionsBtn.setAttribute('aria-expanded', 'false');
        }

        if (btn && panel) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = !panel.hidden;
                panel.hidden = open;
                btn.setAttribute('aria-expanded', String(!open));
                closeActionsMenu();
            });
            panel.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        if (actionsBtn && actionsPanel) {
            actionsBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = !actionsPanel.hidden;
                actionsPanel.hidden = open;
                actionsBtn.setAttribute('aria-expanded', String(!open));
                closeHeaderMenu();
            });
            actionsPanel.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        }

        document.addEventListener('click', function (e) {
            var t = e.target;
            if (btn && btn.contains(t)) return;
            if (panel && panel.contains(t)) return;
            if (actionsBtn && actionsBtn.contains(t)) return;
            if (actionsPanel && actionsPanel.contains(t)) return;
            closeHeaderMenu();
            closeActionsMenu();
        });
    })();
</script>
