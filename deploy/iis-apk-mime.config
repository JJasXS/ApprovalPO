<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS MIME map for the Chainway companion APK.
  ApprovalPO runs as a Kestrel Windows service. Use this snippet only if IIS
  is placed in front of the site. Do not switch the service to IIS for this file.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>
</configuration>
