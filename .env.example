# App mode (loaded before startup). Controls OTP behaviour:
#   APP_ENV=dev   → Development: OTP auto-fills in the browser (no Gmail needed)
#   APP_ENV=prod  → Production: OTP only via email (SMTP)
# Aliases: development|production. Or set ASPNETCORE_ENVIRONMENT directly.
APP_ENV=prod
#
# Tenant code is sent to the tenant-config API (?tenantCode=...) to load dbHost, dbPath, port, etc.
TENANT_CODE=YOUR_TENANT_CODE
#
# Tenant bootstrap API (required). Set via env or TenantBootstrap:AwsApiBaseUrl in appsettings.
TENANT_BOOTSTRAP_API_URL=https://your-api-gateway-url/default/proacc-tenant-config-api
# TenantBootstrap__AwsApiBaseUrl=https://your-api-gateway-url/default/proacc-tenant-config-api
#
# Firebird SYSDBA password (required for login — maps to TenantBootstrap:FirebirdPassword).
FIREBIRD_PASSWORD=YOUR_FIREBIRD_PASSWORD
#
# Optional: override tenant-config database.dbPath / dbHost on this machine only.
# FIREBIRD_DB_PATH=C:\eStream\SQLAccounting\DB\ACC-UAMAT.FDB
# FIREBIRD_DB_HOST=localhost
#
# Optional: only this machine can open the site (not LAN). In appsettings: App__Approval__BindLoopbackOnly=true
# PEM: place .certs/site.pem + .certs/site.key next to ApprovalPO.exe, or set APPROVALPO_TLS_PEM / APPROVALPO_TLS_KEY (paths).
# PFX: place tls/site.pfx (or set Approval:TlsPfxPath) and APPROVALPO_TLS_PFX_PASSWORD.
#
# Prod emergency only (insecure): if SMTP fails, still show OTP in the browser.
# Prefer APP_ENV=dev for local work instead.
# App__Approval__ExposeOtpWhenEmailFails=true
# Or flat env: APPROVALPO_ALLOW_OTP_WITHOUT_EMAIL=true
#
# OTP mail uses the same tenant "email" block + Secrets Manager as ProAccScanner when Dynamo has smtpAppPasswordSecretRef.
# Set AWS_REGION (or appsettings AWS:Region) and give this host IAM or ~/.aws credentials that can read that secret.
#
# Optional: OpenAI vision OCR (Analyze with AI on the ScanPO detail page). Key stays server-side only.
# OPENAI_API_KEY=sk-...
# or: OpenAi__ApiKey=sk-...   (and optionally OpenAi__Model=gpt-4o-mini)
